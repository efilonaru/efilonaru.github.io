---
import Layout from "../layouts/Layout.astro";
import BlogCard from "../components/Blog.astro";

// Astro.glob throws when nothing matches, so empty = no posts yet
let posts = [];
try {
  posts = await Astro.glob("./posts/*.md");
} catch {
  posts = [];
}
---

<Layout title="Blog">
  <h1 class="text-2xl font-bold mb-4 text-zinc-200">Blog Posts</h1>
  <div class="space-y-8">
    {
      posts.length === 0 ? (
        <p class="text-zinc-400">No blog posts available yet.</p>
      ) : (
        posts.map((post) => (
          <BlogCard
            href={post.url}
            title={post.frontmatter.title}
            date={post.frontmatter.date}
            description={post.frontmatter.description}
          />
        ))
      )
    }
  </div>
</Layout>

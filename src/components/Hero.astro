---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Naufal Yasir",
  description = "Apple Developer Academy learner focused on building creative things with Swift and JavaScript.",
} = Astro.props;
---

<div>
  <h1 class="text-2xl font-bold text-neutral-200">{title}</h1>
  <p class="mt-4">
    {description}
  </p>
</div>

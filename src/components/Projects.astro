---
const projects = [
  {
    title: "Ciki",
    description:
      "Solo project. Bite-sized iOS puzzle game starring a shapeshifting pixel octopus, with four mini-games, no ads or tracking, and VoiceOver support.",
    url: "https://apps.apple.com/id/app/ciki/id6834781595",
    stack: ["Swift", "SwiftUI", "SpriteKit"],
  },
  {
    title: "Nimbus Harvest",
    description:
      "Team project. Pixel-art idle farming game where your local weather drives crop growth. I drew the pixel art and assets, then moved to code for polish.",
    url: "https://apps.apple.com/id/app/nimbus-harvest/id6770053044",
    stack: ["Swift", "SwiftUI", "SpriteKit", "WeatherKit", "WidgetKit"],
  },
  {
    title: "Kumpul",
    description: "Collection of fun minigames to play with friends in person.",
    url: "https://kumpul.efilonaru.com",
    stack: ["Next.js", "TypeScript", "Tailwind CSS"],
  },
  {
    title: "BudgetBonsai",
    description:
      "Android expense tracker with AI-powered financial health predictions.",
    url: "https://github.com/BudgetBonsai/BudgetBonsai-app",
    stack: ["Kotlin"],
  },
];
---

<section aria-labelledby="projects-heading" class="mt-12">
  <h2 id="projects-heading" class="text-lg font-bold text-neutral-200">Projects</h2>
  <ul class="mt-4 space-y-6">
    {
      projects.map(({ title, description, url, stack }) => (
        <li>
          <h3 class="font-bold text-neutral-200">
            {url ? (
              <a
                href={url}
                target="_blank"
                rel="noopener noreferrer"
                class="link"
              >
                {title}
              </a>
            ) : (
              title
            )}
          </h3>
          <p class="mt-1">{description}</p>
          <p class="mt-1 text-sm text-neutral-500">{stack.join(" · ")}</p>
        </li>
      ))
    }
  </ul>
</section>

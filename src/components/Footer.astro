---
const {
  links = [
    { href: "https://github.com/efilonaru", text: "Github" },
    { href: "https://linkedin.com/in/naufalym", text: "LinkedIn" },
    { href: "mailto:nymuafa@gmail.com", text: "Email" },
  ],
} = Astro.props;
---

<footer class="mt-4 pt-8">
  <div class="flex space-x-4">
    {
      links.map((link) => (
        <a
          href={link.href}
          target={link.href.startsWith("http") ? "_blank" : undefined}
          rel={link.href.startsWith("http") ? "noopener noreferrer" : undefined}
          class="rounded-sm text-sm underline underline-offset-4 decoration-neutral-600 hover:text-neutral-200 hover:decoration-neutral-200 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-neutral-300"
        >
          {link.text}
        </a>
      ))
    }
  </div>
</footer>

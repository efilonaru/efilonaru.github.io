---
const {
  links = [
    { href: "https://github.com/efilonaru", text: "Github" },
    { href: "https://linkedin.com/in/naufalym", text: "LinkedIn" },
    { href: "mailto:nymuafa@gmail.com", text: "Email" },
  ],
} = Astro.props;
---

<footer class="mt-4 pt-8">
  <div class="flex space-x-4">
    {
      links.map((link) => (
        <a
          href={link.href}
          target={link.href.startsWith("http") ? "_blank" : undefined}
          rel={link.href.startsWith("http") ? "noopener noreferrer" : undefined}
          class="relative px-1 overflow-hidden group"
        >
          <span class="relative z-10 group-hover:text-black transition-colors duration-300 text-sm">
            {link.text}
          </span>
          <span class="absolute left-0 bottom-0 w-full h-0 bg-white transition-all duration-300 ease-out group-hover:h-full" />
        </a>
      ))
    }
  </div>
</footer>
